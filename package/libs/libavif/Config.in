config BR2_PACKAGE_LIBAVIF
	bool "libavif"
	depends on !BR2_STATIC_LIBS # dav1d
	depends on BR2_TOOLCHAIN_HAS_THREADS # dav1d
	select BR2_HOST_CMAKE_AT_LEAST_3_22
	select BR2_PACKAGE_DAV1D
	help
	  libavif is the reference library for the AVIF image format. It
	  decodes through dav1d; encoding needs an AV1 encoder, which
	  Buildroot does not package.

	  https://github.com/AOMediaCodec/libavif

comment "libavif needs a toolchain w/ threads, dynamic library"
	depends on !BR2_TOOLCHAIN_HAS_THREADS || BR2_STATIC_LIBS
