config BR2_PACKAGE_MOZJS128
	bool "mozjs128"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_WCHAR
	depends on BR2_USE_MMU
	depends on !BR2_STATIC_LIBS
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	select BR2_PACKAGE_ZLIB
	# Its configure imports mach.logging, which imports the vendored
	# blessed, which imports curses - so the host interpreter needs the
	# module or configure stops before it starts.
	select BR2_PACKAGE_HOST_PYTHON3_CURSES
	help
	  SpiderMonkey 128 ESR, Mozilla's JavaScript engine, built
	  standalone from the Firefox ESR source. gjs - and through it
	  gnome-shell - runs on it.

	  https://spidermonkey.dev
