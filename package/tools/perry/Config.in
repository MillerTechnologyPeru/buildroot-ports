config BR2_PACKAGE_PERRY_ARCH_SUPPORTS
	bool
	default y if BR2_aarch64 || BR2_x86_64
	default y if BR2_arm && BR2_ARM_CPU_ARMV7A # perry32
	default y if BR2_powerpc

config BR2_PACKAGE_PERRY
	bool "perry"
	depends on BR2_PACKAGE_PERRY_ARCH_SUPPORTS
	depends on BR2_PACKAGE_SWIFT
	depends on !BR2_STATIC_LIBS # sdl3
	depends on BR2_USE_WCHAR # sdl3
	depends on BR2_TOOLCHAIN_HAS_THREADS # sdl3, libheif
	depends on BR2_INSTALL_LIBSTDCPP # libheif
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_10 # libheif
	depends on !BR2_TOOLCHAIN_HAS_BINUTILS_BUG_30730 # libheif
	depends on BR2_PACKAGE_OPENBLAS_ARCH_SUPPORTS
	depends on BR2_USE_MMU # dbus
	select BR2_PACKAGE_SWIFT_FOUNDATION
	select BR2_PACKAGE_SDL3
	select BR2_PACKAGE_CAIRO
	select BR2_PACKAGE_CAIRO_PNG
	select BR2_PACKAGE_FONTCONFIG
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_LIBXML2
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_JPEG
	select BR2_PACKAGE_GIFLIB
	select BR2_PACKAGE_WEBP
	select BR2_PACKAGE_LIBHEIF
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_BZIP2
	select BR2_PACKAGE_XZ
	select BR2_PACKAGE_LZ4
	select BR2_PACKAGE_BROTLI
	select BR2_PACKAGE_EXPAT
	select BR2_PACKAGE_SQLITE
	select BR2_PACKAGE_OPENBLAS
	select BR2_PACKAGE_DBUS
	help
	  Perry runs Mac programs' Mach-O binaries on Linux natively:
	  their own code runs on the CPU, and the libraries and
	  frameworks they call are Linux libraries ("providers")
	  written mostly in Swift.

	  It installs the loader and every provider that builds on Linux
	  in /usr/lib/perry, where the loader finds them beside itself,
	  but JavaScriptCore's, which needs WebKit. No Swift: Darwin's
	  Swift runtime and Perry's Swift overlays are compiled on a Mac
	  and not included.

	  On arm64 and x86_64, perry runs arm64 iOS and Mac programs, and
	  x86_64 Mac ones.

	  On 32-bit ARM it builds perry32, which runs armv7 iOS programs
	  as a 32-bit process, with iOS's providers only (no AppKit). In
	  a 32-bit companion it becomes the image's /usr/lib32/perry, and
	  perry hands armv7 programs to it.

	  On 32-bit PowerPC, perry runs ppc Mac OS X 10.3 to 10.5
	  programs, translating between Darwin's ppc calling convention
	  and Linux's, with Carbon's provider too, but not Security's,
	  whose BoringSSL is little-endian only, Core Data's, which
	  Swift's compiler cannot yet build for PowerPC, or Metal's and
	  UIKit's.

	  Building it resolves Perry's Swift package dependencies and
	  fetches SQLite, lzfse and swift-cmark, so it needs network
	  access.

	  https://github.com/MillerTechnologyPeru/Perry

comment "perry needs the Swift runtime (the buildroot-swift external)"
	depends on BR2_PACKAGE_PERRY_ARCH_SUPPORTS
	depends on !BR2_PACKAGE_SWIFT

comment "perry needs a toolchain w/ C++, wchar, threads, dynamic library, gcc >= 10"
	depends on BR2_PACKAGE_PERRY_ARCH_SUPPORTS
	depends on BR2_PACKAGE_SWIFT
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_USE_WCHAR || \
		!BR2_TOOLCHAIN_HAS_THREADS || BR2_STATIC_LIBS || \
		!BR2_TOOLCHAIN_GCC_AT_LEAST_10
